{
  "name": "woodpecker-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Entrenador de tácticas de ajedrez basado en el Woodpecker Method (Smith & Tikkanen)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "gen:puzzles": "node scripts/generate-starter-set.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "build:single": "node scripts/build-single-file.mjs"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "cm-chessboard": "^8.12.19",
    "fzstd": "^0.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
